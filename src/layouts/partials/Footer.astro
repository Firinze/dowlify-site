---
import Social from "@/components/Social.astro";
import Logo from "@/components/Logo.astro";
import config from "@/config/config.json";
import menu from "@/config/menu.json";
import social from "@/config/social.json";
import { withBase } from "@/lib/utils/href";
import { markdownify } from "@/lib/utils/textConverter";
import type { Menu, SocialType } from "@/types";

const {
  footer_primary,
  footer_resource,
  footer_legal,
  footer_col_1_title,
  footer_col_2_title,
  footer_col_3_title,
} = menu as Menu;
const { main: socialLinks } = social as SocialType;
---

<footer class="section pb-0 relative overflow-hidden">
  <div class="container pb-10">
    <div class="flex lg:justify-between flex-wrap gap-x-10 gap-y-10">
      <div class="max-w-95 mb-12 text-lg text-text">
        <Logo variant="footer" />
        <p class="mt-6 text-base">{config.params.footer_tagline}</p>
        <a
          class="link mt-6 inline-block underline text-base"
          href={withBase("/versions/1-0-0")}
        >
          Dernière version : Dowlify 1.0.0
        </a>
      </div>

      <div>
        <h3 class="footer-label">{footer_col_1_title}</h3>
        <ul>
          {
            footer_primary?.map((item) => (
              <li class="mb-5">
                <a href={withBase(item.url)} class="footer-link">
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="footer-label">{footer_col_2_title}</h3>
        <ul>
          {
            footer_resource?.map((item) => (
              <li class="mb-5">
                <a
                  href={withBase(item.url)}
                  class="footer-link"
                  target={item.url.startsWith("http") ? "_blank" : undefined}
                  rel={
                    item.url.startsWith("http")
                      ? "noopener noreferrer"
                      : undefined
                  }
                >
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="footer-label">{footer_col_3_title}</h3>
        <ul>
          {
            footer_legal?.map((item) => (
              <li class="mb-5">
                <a href={withBase(item.url)} class="footer-link">
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <hr
    class="h-px bg-linear-to-r from-transparent from-25% via-white/50 to-75% to-transparent border-0"
  />
  <div class="container py-7">
    <div
      class="flex justify-between lg:items-center flex-col lg:flex-row gap-y-6 w-full"
    >
      <p
        class="text-base text-text"
        set:html={markdownify(config.params.copyright)}
      />

      <Social className="social-icons lg:ml-auto" source={socialLinks} />
    </div>
  </div>

  <div
    class="absolute bottom-0 left-1/2 size-280 blur-2xl -translate-x-1/2 translate-y-1/2 -z-10"
    style="background: radial-gradient(circle, color-mix(in srgb, var(--color-primary) 30%, transparent) 0%, transparent 80%);"
  >
  </div>
</footer>
