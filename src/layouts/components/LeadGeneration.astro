---
import ImageMod from "@/layouts/components/ImageMod.astro";
import { LATEST_RELEASE } from "@/data/releases";
import { withBase } from "@/lib/utils/href";
import { markdownify } from "@/lib/utils/textConverter";

interface Props {
  lead_generation: any;
}

const { lead_generation } = Astro.props;
const installerHref = LATEST_RELEASE.downloadUrl;
const edgeHref =
  "https://microsoftedge.microsoft.com/addons/detail/pjomjfkfiagbbpdfklanamggblbfiakn";
---

<section class="section-box bg-transparent my-0 pb-0">
  <div class="container-sm">
    <div class="section-container pb-20">
      <div class="section-intro centralize">
        <h2 class="title hasHighlight" set:html={lead_generation.title} />
      </div>
      <div class="section-content">
        <div class="flex flex-col-reverse lg:flex-row gap-x-20 gap-y-10 items-center">
          <div class="lg:w-6/12">
            <h3 class="text-h5-sm font-bold mb-7">
              {lead_generation.subtitle}
            </h3>
            <div
              class="space-y-4"
              set:html={markdownify(lead_generation.content, true)}
            />
            <ul class="green-tick-list [&>li]:mb-8 mt-10">
              {
                lead_generation.list.map((item: string) => (
                  <li set:html={markdownify(item)} />
                ))
              }
            </ul>
          </div>
          <div class="lg:w-6/12">
            <div class="bg-light rounded-4xl corner-squircle p-8 xl:px-7.5 xl:py-9">
              <div class="rounded-2xl overflow-hidden border border-border bg-body mb-8 max-w-88 mx-auto">
                <ImageMod
                  src={lead_generation.image}
                  width={420}
                  height={560}
                  alt="Extension navigateur Dowlify pour Microsoft Edge et Google Chrome"
                  class="w-full h-auto block"
                />
              </div>
              <div class="flex flex-col gap-3">
                <a
                  href={installerHref}
                  data-dowlify-download
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-primary w-full text-center"
                >
                  {lead_generation.button?.label ?? "Télécharger Dowlify"}
                </a>
                <a
                  href={withBase(edgeHref)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-outline w-full text-center"
                >
                  Installer sur Edge
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <hr class="h-px bg-linear-to-r from-transparent from-10% via-white/50 to-90% to-transparent border-0" />
</section>
