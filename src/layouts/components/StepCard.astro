---
import ImageMod from "./ImageMod.astro";

interface Props {
  image: string;
  number: string;
  title: string;
  content: string;
}
const { image, number, title, content } = Astro.props;
---

<div class="p-5 sm:p-8 xl:px-24 xl:py-6 relative" data-bn-card={number}>
  <div class="flex items-center flex-col lg:flex-row lg:justify-between gap-6">
    <div class="max-lg:order-1 w-full max-w-full sm:max-w-[330px] rounded-2xl overflow-hidden border border-border bg-body shadow-lg shrink-0">
      <ImageMod
        src={image}
        alt={title}
        class="w-full h-auto block"
        width={660}
        height={440}
      />
    </div>
    <div class="relative grid place-items-center max-lg:order-0 min-w-0 sm:min-w-[200px]">
      <div
        class="text-[5rem] lg:text-[100px] font-extrabold t-stroke text-transparent leading-none"
      >
        {number}
      </div>
      <h3 class="text-h5-sm font-bold absolute text-center sm:whitespace-nowrap">{title}</h3>
    </div>
    <p class="lg:col-4 text-sm max-lg:my-4 max-lg:order-3 text-text/90">{content}</p>
  </div>
  <div class="absolute inset-0 size-full -z-10">
    <div
      class="border border-border size-full rounded-t-4xl rounded-b-4xl bg-primary/5 corner-squircle"
      style="transform: perspective(100px) rotateX(-2deg);"
    >
    </div>
  </div>
</div>
