---
import { withBase } from "@/lib/utils/href";

interface Feature {
  label: string;
  included: boolean;
  tooltip?: string;
}

interface Props {
  price: string;
  yearly_price: string;
  title: string;
  is_featured?: boolean;
  offer_text?: string;
  button: { enable: boolean; label: string; link: string };
  description?: string;
  features?: Feature[];
}

const {
  price,
  title,
  is_featured = false,
  offer_text,
  button,
  description,
  features,
} = Astro.props;

const isInstaller = button.link.includes("DowlifySetup");
---

<div
  class={`py-10 px-7 rounded-3xl text-left relative ${is_featured ? "bg-light/50 overflow-hidden" : "bg-light/80"}`}
>
  {
    is_featured && (
      <>
        <div class="absolute bottom-0 right-0 translate-y-1/2 translate-x-1/2 grid place-items-center -z-10">
          <div class="size-160 bg-radial from-primary to-transparent from-0% to-70% rounded-full" />
        </div>
        {offer_text && (
          <div class="absolute top-10 right-5 transform bg-primary/50 text-white text-xs font-semibold py-1.5 px-3 rounded-lg">
            {offer_text}
          </div>
        )}
      </>
    )
  }

  <div class="mb-8 leading-none">
    <span class="text-white text-h3 font-semibold tabular-nums">
      {price}
      <span class="ml-1.5 text-sm font-normal text-text">
        sans abonnement
      </span>
    </span>
  </div>

  <h3 class="text-h6 text-white mb-5">{title}</h3>
  <p class="text-text-dark">{description}</p>

  {
    button.enable && (
      <div class="mt-8 mb-9">
        <a
          href={withBase(button.link)}
          data-dowlify-download={isInstaller ? "" : undefined}
          target={button.link.startsWith("http") ? "_blank" : undefined}
          rel={button.link.startsWith("http") ? "noopener noreferrer" : undefined}
          class={`btn w-full text-center ${is_featured ? "btn-primary" : "btn-outline"}`}
        >
          {button.label}
        </a>
      </div>
    )
  }

  <div class="text-white font-bold mb-6">Inclus dès l'installation</div>

  <ul class="space-y-4">
    {
      (features || []).map((f) => (
        <li class="flex items-start gap-x-4">
          {f.included ? (
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              class="shrink-0"
            >
              <rect width="24" height="24" rx="6" fill="var(--color-primary)" />
              <path
                d="M11.1799 15.6864L17.6989 8.82757C18.1004 8.40902 18.1004 7.73247 17.6989 7.31392C17.2974 6.89536 16.6484 6.89536 16.2468 7.31392L10.4539 13.4159L7.75315 10.5847C7.35164 10.1661 6.70265 10.1661 6.30113 10.5847C5.89962 11.0032 5.89962 11.6798 6.30113 12.0983L9.72792 15.6864C9.92816 15.8951 10.191 16 10.4539 16C10.7168 16 10.9797 15.8951 11.1799 15.6864Z"
                fill="white"
              />
            </svg>
          ) : (
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              class="shrink-0"
            >
              <rect
                opacity="0.2"
                width="24"
                height="24"
                rx="6"
                fill="var(--color-text-light)"
              />
              <rect
                x="18"
                y="11"
                width="2"
                height="12"
                rx="1"
                transform="rotate(90 18 11)"
                fill="white"
                fill-opacity="0.4"
              />
            </svg>
          )}
          <span>{f.label}</span>
        </li>
      ))
    }
  </ul>
</div>
